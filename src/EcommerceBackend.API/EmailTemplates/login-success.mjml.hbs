<mjml>
  <mj-body background-color="#f4f4f4">
    <mj-section padding="20px 0">
      <mj-column background-color="#ffffff" border-radius="12px" padding="24px">
        <mj-text font-size="22px" font-weight="bold" color="#111111">
          Login successful
        </mj-text>

        <mj-text font-size="16px" color="#333333">
          Hello {{FullName}},
        </mj-text>

        <mj-text font-size="15px" color="#333333">
          Your account <b>{{Email}}</b> has just logged in successfully.
        </mj-text>

        <mj-text font-size="15px" color="#333333">
          Login time: <b>{{LoginAtDisplay}}</b>
        </mj-text>

        <mj-divider border-color="#e5e7eb" />

        <mj-text font-size="13px" color="#6b7280">
          If this wasn't you, please change your password immediately.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>